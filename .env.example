# LekoAIFinance — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA versione o .env (ele já está no .gitignore).

# Token do bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=

# Projeto Supabase (Fonte da Verdade)
SUPABASE_URL=
SUPABASE_KEY=

# Chave da API Groq (Camada 2 - IA). Crie em https://console.groq.com/keys
GROQ_API_KEY=

# Segredo do webhook do Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Gere um valor aleatório e registre no Telegram via setWebhook (secret_token=...).
WEBHOOK_SECRET=

# Token que protege a ESCRITA em /api/chamados (GitHub Actions e o dashboard usam).
# OBRIGATÓRIO: sem este valor, create/patch/delete são NEGADOS (falha fechada).
# O mesmo valor precisa estar em 3 lugares: aqui, nas env vars da Vercel e no
# secret DASHBOARD_TOKEN do repositório no GitHub.
# Gere um valor aleatório (ex: python -c "import secrets; print(secrets.token_hex(32))")
DASHBOARD_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Monetização (paywall + gateway AbacatePay). Ver implementation_plan.md.
# ─────────────────────────────────────────────────────────────────────────────

# Liga/desliga o paywall inteiro. Em produção fica "true"; no .env local, "false"
# para testar sem bloquear ninguém. Na Vercel, escopar "false" só para Preview.
PAYWALL_ENABLED=false

# IDs de Telegram (separados por vírgula) que NUNCA são bloqueados — você, para
# testar no bot real. Vale inclusive em produção. Ex: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Chave da API do AbacatePay (Bearer) usada para CRIAR cobranças (PIX e assinatura).
# Pegue no painel do AbacatePay. Use a chave de teste/devMode enquanto valida.
ABACATEPAY_API_KEY=

# Segredo que valida o WEBHOOK do AbacatePay (chega junto na query string e é a
# base do HMAC-SHA256 do header X-Webhook-Signature).
# OBRIGATÓRIO: sem este valor o webhook NEGA tudo (falha fechada) — senão qualquer
# um poderia forjar "compra aprovada" e ganhar plano vitalício.
# Registre o mesmo valor na URL do webhook cadastrada no painel do AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=
